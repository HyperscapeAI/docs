# ==========================================
# STREAMING & GPU CONFIGURATION
# ==========================================
# Additional environment variables for RTMP streaming and GPU rendering.
# Append these to your packages/server/.env file for streaming deployments.
#
# See also:
#   - docs/streaming-configuration.md - Full streaming reference
#   - docs/vast-deployment.md - Vast.ai deployment guide
#   - docs/webgpu-requirements.md - WebGPU requirements

# ==========================================
# GPU & DISPLAY CONFIGURATION
# ==========================================

# X Server Display Number
# The display server Chrome will connect to for WebGPU access
DISPLAY=:99

# Vulkan ICD Configuration
# Force NVIDIA-only Vulkan ICD to avoid conflicts with broken Mesa ICDs
VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json

# GPU Rendering Mode (set automatically by deploy-vast.sh)
# Values: xorg | xvfb-vulkan
# - xorg: Full hardware acceleration with Xorg + NVIDIA driver
# - xvfb-vulkan: Virtual framebuffer + NVIDIA Vulkan (fallback)
GPU_RENDERING_MODE=xorg

# Xvfb Usage Flag (set automatically by deploy-vast.sh)
# true = Using Xvfb virtual framebuffer
# false = Using Xorg with NVIDIA driver
DUEL_CAPTURE_USE_XVFB=false

# ==========================================
# CHROME CONFIGURATION
# ==========================================

# Browser Channel
# Use Chrome Dev channel (google-chrome-unstable) for WebGPU support
# Playwright channel mapping: chrome-dev -> google-chrome-unstable
STREAM_CAPTURE_CHANNEL=chrome-dev

# ANGLE Backend
# Vulkan required for WebGPU (metal on macOS, vulkan elsewhere)
STREAM_CAPTURE_ANGLE=vulkan

# Headless Mode
# MUST be false for WebGPU - headless Chrome doesn't support WebGPU
STREAM_CAPTURE_HEADLESS=false

# WebGPU Enforcement
# These are deprecated but kept for backwards compatibility
# WebGPU is ALWAYS enabled - there is NO WebGL fallback
STREAM_CAPTURE_DISABLE_WEBGPU=false
DUEL_FORCE_WEBGL_FALLBACK=false
STREAM_CAPTURE_USE_EGL=false

# ==========================================
# CAPTURE CONFIGURATION
# ==========================================

# Capture Mode
# Values: cdp | mediarecorder | webcodecs
# - cdp: Chrome DevTools Protocol screencast (recommended, 2-3x faster)
# - mediarecorder: Legacy MediaRecorder API with WebSocket
# - webcodecs: Experimental VideoEncoder API (falls back to CDP)
STREAM_CAPTURE_MODE=cdp

# Viewport Resolution (must be even numbers)
STREAM_CAPTURE_WIDTH=1280
STREAM_CAPTURE_HEIGHT=720

# Frame Rate
STREAM_FPS=30

# CDP JPEG Quality (1-100, only for CDP mode)
STREAM_CDP_QUALITY=80

# Capture Recovery
# Timeout for CDP recovery attempts (milliseconds)
STREAM_CAPTURE_RECOVERY_TIMEOUT_MS=30000
# Max failures before falling back to MediaRecorder
STREAM_CAPTURE_RECOVERY_MAX_FAILURES=6

# ==========================================
# AUDIO CONFIGURATION
# ==========================================

# PulseAudio Runtime Directory
XDG_RUNTIME_DIR=/tmp/pulse-runtime

# PulseAudio Server Socket
PULSE_SERVER=unix:/tmp/pulse-runtime/pulse/native

# Audio Capture Enable
STREAM_AUDIO_ENABLED=true

# PulseAudio Monitor Device
# The monitor device for the chrome_audio sink
PULSE_AUDIO_DEVICE=chrome_audio.monitor

# ==========================================
# FFMPEG ENCODING CONFIGURATION
# ==========================================

# FFmpeg Binary Path
FFMPEG_PATH=/usr/bin/ffmpeg

# Video Bitrate
STREAM_BITRATE=4500k

# Buffer Size (multiplier of bitrate)
# 4x = 18000k buffer (was 2x = 9000k)
STREAM_BUFFER_MULTIPLIER=4

# x264 Tune
# Values: film | zerolatency
# - film: Better compression, allows B-frames (default)
# - zerolatency: Minimal latency, no B-frames
STREAM_LOW_LATENCY=false

# x264 Preset
# Values: ultrafast | superfast | veryfast | faster | fast | medium | slow
STREAM_X264_PRESET=veryfast

# ==========================================
# RTMP DESTINATIONS
# ==========================================

# Twitch
TWITCH_STREAM_KEY=live_xxxxx_yyyyy
TWITCH_RTMP_URL=rtmp://live.twitch.tv/app

# Kick (uses RTMPS)
KICK_STREAM_KEY=sk_us-west-2_xxxxx
KICK_RTMP_URL=rtmps://fa723fc1b171.global-contribute.live-video.net/app

# X/Twitter
X_STREAM_KEY=xxxxx
X_RTMP_URL=rtmp://sg.pscp.tv:80/x

# YouTube (explicitly disabled)
# Set to empty string to prevent stale keys from being used
YOUTUBE_STREAM_KEY=
YOUTUBE_RTMP_STREAM_KEY=

# ==========================================
# STREAMING BEHAVIOR
# ==========================================

# Canonical Platform for Timing
# Values: twitch | youtube | hls
# Twitch has lower latency than YouTube
STREAMING_CANONICAL_PLATFORM=twitch

# Public Data Delay
# Delay all public streaming/arena API state by N milliseconds
# Set to 0 for live betting (no delay)
STREAMING_PUBLIC_DELAY_MS=0

# Viewer Access Token
# Optional secret token for trusted live WebSocket viewers
# STREAMING_VIEWER_ACCESS_TOKEN=replace-with-random-secret-token

# ==========================================
# GAME URL CONFIGURATION
# ==========================================

# Primary Game URL
GAME_URL=http://localhost:3333/?page=stream

# Fallback URLs (comma-separated)
GAME_FALLBACK_URLS=http://localhost:3333/?embedded=true&mode=spectator,http://localhost:3333/

# ==========================================
# STREAMING HEALTH & MONITORING
# ==========================================

# Disable bridge capture (for debugging)
DUEL_DISABLE_BRIDGE_CAPTURE=false

# Combat AI for streaming duels
# Set to false to reduce CPU usage during long streams
STREAMING_DUEL_COMBAT_AI_ENABLED=false

# Server runtime tick limits
SERVER_RUNTIME_MAX_TICKS_PER_FRAME=1
SERVER_RUNTIME_MIN_DELAY_MS=10

# Game state polling
GAME_STATE_POLL_TIMEOUT_MS=5000
GAME_STATE_POLL_INTERVAL_MS=3000

# Duel runtime health checks
DUEL_RUNTIME_HEALTH_INTERVAL_MS=15000
DUEL_RUNTIME_HEALTH_MAX_FAILURES=30

# ==========================================
# SOLANA CONFIGURATION
# ==========================================

# Solana RPC Endpoints
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com/

# Solana Keypairs (base58 encoded private keys)
# Used for on-chain market creation and settlement
# Set SOLANA_DEPLOYER_PRIVATE_KEY to configure all three at once
SOLANA_ARENA_AUTHORITY_SECRET=
SOLANA_ARENA_REPORTER_SECRET=
SOLANA_ARENA_KEEPER_SECRET=

# Market Maker Keypair (for liquidity seeding)
SOLANA_MM_PRIVATE_KEY=

# Market Configuration
# Use native token (WSOL) instead of custom GOLD
MARKET_MINT=So11111111111111111111111111111111111111112  # WSOL

# Perps Oracle (disabled by default - program not deployed on devnet)
ENABLE_PERPS_ORACLE=false

# ==========================================
# DEPLOYMENT NOTES
# ==========================================
#
# Vast.ai Deployment Checklist:
# 1. ✅ NVIDIA GPU with Vulkan support
# 2. ✅ NVIDIA drivers installed (nvidia-smi works)
# 3. ✅ Vulkan tools installed (vulkaninfo works)
# 4. ✅ X server packages (Xorg or Xvfb)
# 5. ✅ Chrome Dev channel (google-chrome-unstable)
# 6. ✅ Display server starts (xdpyinfo -display :99)
# 7. ✅ Vulkan ICD configured (VK_ICD_FILENAMES set)
# 8. ✅ WebGPU works in Chrome (chrome://gpu shows hardware accelerated)
#
# The deploy-vast.sh script handles all of this automatically.
#
# ==========================================
