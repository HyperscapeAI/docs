# Hyperscape Environment Variables
#
# FOR LOCAL DEVELOPMENT: Copy to .env and fill in your values
# FOR PRODUCTION (Vast.ai): Set these as GitHub Secrets in the repository
#
# Required GitHub Secrets for CI/CD:
#   - TWITCH_STREAM_KEY (or TWITCH_RTMP_STREAM_KEY)
#   - KICK_STREAM_KEY
#   - KICK_RTMP_URL
#   - X_STREAM_KEY
#   - X_RTMP_URL
#   - DATABASE_URL
#   - SOLANA_DEPLOYER_PRIVATE_KEY
#   - VAST_HOST, VAST_PORT, VAST_SSH_KEY (for deployment)
#
# NEVER commit secrets to the repository - they will be exposed in git history

# ============================================================================
# STREAMING KEYS (Required for live streaming)
# ============================================================================

# Twitch - Get from https://dashboard.twitch.tv/settings/stream
# Both formats supported (auto-detected via || logic)
TWITCH_STREAM_KEY=
TWITCH_RTMP_STREAM_KEY=

# Kick - Get from https://kick.com/dashboard/settings/stream
KICK_STREAM_KEY=
KICK_RTMP_URL=rtmps://fa723fc1b171.global-contribute.live-video.net/app

# X/Twitter - Get from https://studio.twitter.com
X_STREAM_KEY=
X_RTMP_URL=rtmp://sg.pscp.tv:80/x

# YouTube (optional)
YOUTUBE_STREAM_KEY=
YOUTUBE_RTMP_STREAM_KEY=

# Stream destinations (auto-detected from available keys if not set)
# STREAM_ENABLED_DESTINATIONS=twitch,kick,youtube

# ============================================================================
# SOLANA KEYS (Required for on-chain features)
# ============================================================================

# Set a single deployer key to use for all roles, or set each individually
SOLANA_DEPLOYER_PRIVATE_KEY=

# Or set individual keys:
# SOLANA_ARENA_AUTHORITY_SECRET=
# SOLANA_ARENA_REPORTER_SECRET=
# SOLANA_ARENA_KEEPER_SECRET=
# SOLANA_MM_PRIVATE_KEY=

# ============================================================================
# DATABASE (Production)
# ============================================================================

# PostgreSQL connection string
# Database mode is auto-detected from hostname (local vs remote)
DATABASE_URL=

# PostgreSQL connection pool configuration (increased March 2026)
# POSTGRES_POOL_MAX=20    # Maximum connections (up from 10)
# POSTGRES_POOL_MIN=2     # Minimum idle connections

# Database mode (auto-detected from DATABASE_URL if not set)
# local: localhost/127.0.0.1/0.0.0.0/::1
# remote: all other hostnames
# DUEL_DATABASE_MODE=remote

# ============================================================================
# CDN CONFIGURATION
# ============================================================================

# CDN URL for game assets (models, textures, audio)
# Production default: https://assets.hyperscape.club
# Local development: http://localhost:8080
# PUBLIC_CDN_URL=https://assets.hyperscape.club
# DUEL_PUBLIC_CDN_URL=https://assets.hyperscape.club

# ============================================================================
# STREAMING CAPTURE CONFIGURATION (Optional)
# ============================================================================

# Streaming capture mode: cdp | mediarecorder
# cdp: Chrome DevTools Protocol screencast (may stall under Xvfb + WebGPU)
# mediarecorder: canvas.captureStream() → WebSocket → FFmpeg (more reliable on Linux)
# Default: mediarecorder (changed March 2026)
# STREAM_CAPTURE_MODE=mediarecorder

# Chrome channel: chrome-beta | chrome-unstable | chrome-canary
# Default: chrome-beta (better stability than unstable/canary)
# Changed from chrome-unstable to chrome-beta in March 2026
# STREAM_CAPTURE_CHANNEL=chrome-beta

# ANGLE backend: default | vulkan | opengl | d3d11
# Default: default (auto-selects best backend for system)
# Changed from vulkan to default in March 2026
# STREAM_CAPTURE_ANGLE=default

# Stream resolution
# STREAM_CAPTURE_WIDTH=1280
# STREAM_CAPTURE_HEIGHT=720

# Headless mode (false for Xorg/Xvfb, true for headless modes)
# STREAM_CAPTURE_HEADLESS=false

# ============================================================================
# DISPLAY (GPU Rendering - Vast.ai/Remote)
# ============================================================================

# X display for GPU rendering
# :0 for real Xorg display, :99 for Xvfb virtual display
# Explicitly forwarded through PM2 environment (commit 704b955)
DISPLAY=:99

# Set to true when using Xvfb virtual display
# Xvfb is started before PM2 in deploy-vast.sh (commit 294a36c)
DUEL_CAPTURE_USE_XVFB=true

# ============================================================================
# ELIZAOS AI CONFIGURATION (Optional)
# ============================================================================

# ElizaCloud API key for unified access to 13 frontier models
# Replaces individual provider keys (OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.)
# Get yours at: https://elizaos.ai/cloud
# ELIZAOS_CLOUD_API_KEY=

# ============================================================================
# DUEL ARENA ORACLE (Optional)
# ============================================================================

# Enable duel outcome oracle publishing to EVM and Solana
# DUEL_ARENA_ORACLE_ENABLED=true
# DUEL_ARENA_ORACLE_PROFILE=testnet  # or mainnet

# Oracle metadata API base URL
# DUEL_ARENA_ORACLE_METADATA_BASE_URL=https://api.hyperscape.gg/api/duel-arena/oracle

# EVM signer (works across Base, BSC, Avalanche)
# DUEL_ARENA_ORACLE_EVM_PRIVATE_KEY=0x...

# Solana signers (authority can initialize, reporter can report outcomes)
# DUEL_ARENA_ORACLE_SOLANA_AUTHORITY_SECRET=
# DUEL_ARENA_ORACLE_SOLANA_REPORTER_SECRET=
