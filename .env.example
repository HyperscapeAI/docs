# Hyperscape Environment Variables
#
# FOR LOCAL DEVELOPMENT: Copy to .env and fill in your values
# FOR PRODUCTION (Vast.ai): Set these as GitHub Secrets in the repository
#
# Required GitHub Secrets for CI/CD:
#   - TWITCH_STREAM_KEY
#   - KICK_STREAM_KEY
#   - KICK_RTMP_URL
#   - X_STREAM_KEY
#   - X_RTMP_URL
#   - DATABASE_URL
#   - SOLANA_DEPLOYER_PRIVATE_KEY
#   - VAST_HOST, VAST_PORT, VAST_SSH_KEY (for deployment)
#   - JWT_SECRET
#   - ARENA_EXTERNAL_BET_WRITE_KEY
#
# NEVER commit secrets to the repository - they will be exposed in git history

# ============================================================================
# STREAMING KEYS (Required for live streaming)
# ============================================================================

# Twitch - Get from https://dashboard.twitch.tv/settings/stream
TWITCH_STREAM_KEY=
# Optional: Override default Twitch ingest URL
TWITCH_RTMP_URL=rtmps://live.twitch.tv/app

# Kick - Get from https://kick.com/dashboard/settings/stream
KICK_STREAM_KEY=
KICK_RTMP_URL=rtmps://fa723fc1b171.global-contribute.live-video.net/app

# X/Twitter - Get from https://studio.twitter.com
X_STREAM_KEY=
X_RTMP_URL=rtmp://sg.pscp.tv:80/x

# YouTube (optional, disabled by default)
YOUTUBE_STREAM_KEY=

# ============================================================================
# SOLANA KEYS (Required for on-chain features)
# ============================================================================

# Set a single deployer key to use for all roles, or set each individually
SOLANA_DEPLOYER_PRIVATE_KEY=

# Or set individual keys:
# SOLANA_ARENA_AUTHORITY_SECRET=
# SOLANA_ARENA_REPORTER_SECRET=
# SOLANA_ARENA_KEEPER_SECRET=
# SOLANA_MM_PRIVATE_KEY=

# ============================================================================
# DATABASE (Production)
# ============================================================================

# PostgreSQL connection string
DATABASE_URL=

# JWT secret for authentication (generate with: openssl rand -base64 32)
JWT_SECRET=

# ============================================================================
# DISPLAY (GPU Rendering - Vast.ai/Remote)
# ============================================================================

# X display server (auto-configured by deploy script)
# :99 for Xorg/Xvfb, :0 for local X server
DISPLAY=:99

# GPU rendering mode (auto-detected by deploy script)
# xorg = Direct GPU access with Xorg
# xvfb-vulkan = Virtual framebuffer with NVIDIA Vulkan
GPU_RENDERING_MODE=xorg

# Use Xvfb virtual display (auto-configured by deploy script)
DUEL_CAPTURE_USE_XVFB=false

# Force NVIDIA Vulkan ICD (prevents Mesa conflicts)
VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json

# ============================================================================
# VIDEO CAPTURE (Streaming)
# ============================================================================

# Capture mode: cdp (fast, recommended) or mediarecorder (legacy)
STREAM_CAPTURE_MODE=cdp

# Headless mode (WebGPU requires display, always false)
STREAM_CAPTURE_HEADLESS=false

# Browser channel (chrome-dev = google-chrome-unstable)
STREAM_CAPTURE_CHANNEL=chrome-dev

# Custom browser executable path (optional)
STREAM_CAPTURE_EXECUTABLE=

# ANGLE backend for WebGPU (vulkan for NVIDIA, metal for macOS)
STREAM_CAPTURE_ANGLE=vulkan

# CDP screencast quality (1-100, default: 80)
STREAM_CDP_QUALITY=80

# Target frame rate (default: 30)
STREAM_FPS=30

# Stream resolution (must be even numbers)
STREAM_CAPTURE_WIDTH=1280
STREAM_CAPTURE_HEIGHT=720

# Recovery settings
STREAM_CAPTURE_RECOVERY_TIMEOUT_MS=30000
STREAM_CAPTURE_RECOVERY_MAX_FAILURES=6

# ============================================================================
# AUDIO CAPTURE (Streaming)
# ============================================================================

# Enable audio capture via PulseAudio
STREAM_AUDIO_ENABLED=true

# PulseAudio monitor device (chrome_audio.monitor)
PULSE_AUDIO_DEVICE=chrome_audio.monitor

# PulseAudio server socket
PULSE_SERVER=unix:/tmp/pulse-runtime/pulse/native

# PulseAudio runtime directory
XDG_RUNTIME_DIR=/tmp/pulse-runtime

# ============================================================================
# ENCODING (Streaming)
# ============================================================================

# Video bitrate in bits per second (default: 4500000 = 4.5 Mbps)
STREAM_BITRATE=4500000

# FFmpeg buffer size (default: 4x bitrate)
STREAM_BUFFER_SIZE=18000000

# x264 preset (ultrafast, veryfast, faster, fast, medium, slow, slower, veryslow)
STREAM_PRESET=medium

# Low-latency mode (enables zerolatency tune, disables B-frames)
STREAM_LOW_LATENCY=false

# GOP size (keyframe interval in frames, default: 60 = 2s at 30fps)
# Configurable via environment variable (added in recent updates)
STREAM_GOP_SIZE=60

# ============================================================================
# GAME URL (Streaming)
# ============================================================================

# Primary game URL for streaming
GAME_URL=http://localhost:3333/?page=stream

# Fallback URLs (comma-separated)
GAME_FALLBACK_URLS=http://localhost:3333/?embedded=true&mode=spectator,http://localhost:3333/

# Viewer access token (optional, for gated streams)
STREAMING_VIEWER_ACCESS_TOKEN=

# ============================================================================
# RTMP BRIDGE (Streaming)
# ============================================================================

# WebSocket port for legacy MediaRecorder bridge
RTMP_BRIDGE_PORT=8765

# Spectator server port (zero-latency WebSocket stream)
SPECTATOR_PORT=4180

# External RTMP status file path (optional)
RTMP_STATUS_FILE=/root/hyperscape/packages/server/public/live/rtmp-status.json

# ============================================================================
# PRODUCTION CLIENT BUILD (Streaming)
# ============================================================================

# Use production client build for faster page loads (recommended for streaming)
# When enabled, serves pre-built client via 'vite preview' instead of dev server
# This prevents browser timeout issues (180s limit) during Vite's on-demand compilation
# Significantly faster page loads for streaming (no JIT module compilation)
DUEL_USE_PRODUCTION_CLIENT=true

# ============================================================================
# DEPRECATED / IGNORED (Kept for backwards compatibility)
# ============================================================================

# WebGPU is REQUIRED - these flags are ignored
STREAM_CAPTURE_DISABLE_WEBGPU=false
DUEL_FORCE_WEBGL_FALLBACK=false

# Headless EGL mode not supported (WebGPU requires display)
STREAM_CAPTURE_USE_EGL=false
