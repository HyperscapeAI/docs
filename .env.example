# Hyperscape Environment Variables
#
# FOR LOCAL DEVELOPMENT: Copy to .env and fill in your values
# FOR PRODUCTION (Vast.ai): Set these as GitHub Secrets in the repository
#
# Required GitHub Secrets for CI/CD:
#   - TWITCH_STREAM_KEY
#   - KICK_STREAM_KEY
#   - KICK_RTMP_URL
#   - X_STREAM_KEY
#   - X_RTMP_URL
#   - DATABASE_URL
#   - SOLANA_DEPLOYER_PRIVATE_KEY
#   - VAST_HOST, VAST_PORT, VAST_SSH_KEY (for deployment)
#
# NEVER commit secrets to the repository - they will be exposed in git history

# ============================================================================
# STREAMING KEYS (Required for live streaming)
# ============================================================================

# Twitch - Get from https://dashboard.twitch.tv/settings/stream
TWITCH_STREAM_KEY=

# Kick - Get from https://kick.com/dashboard/settings/stream
KICK_STREAM_KEY=
KICK_RTMP_URL=rtmps://fa723fc1b171.global-contribute.live-video.net/app

# X/Twitter - Get from https://studio.twitter.com
X_STREAM_KEY=
X_RTMP_URL=rtmp://sg.pscp.tv:80/x

# YouTube (optional, currently disabled in production)
YOUTUBE_STREAM_KEY=

# ============================================================================
# SOLANA KEYS (Required for on-chain features)
# ============================================================================

# Set a single deployer key to use for all roles, or set each individually
SOLANA_DEPLOYER_PRIVATE_KEY=

# Or set individual keys:
# SOLANA_ARENA_AUTHORITY_SECRET=
# SOLANA_ARENA_REPORTER_SECRET=
# SOLANA_ARENA_KEEPER_SECRET=
# SOLANA_MM_PRIVATE_KEY=

# ============================================================================
# DATABASE (Production)
# ============================================================================

# PostgreSQL connection string
DATABASE_URL=

# PostgreSQL connection pool configuration (for production/streaming deployments)
# Reduced pool size prevents connection exhaustion during crash loops
# POSTGRES_POOL_MAX=3    # Maximum connections (down from 6)
# POSTGRES_POOL_MIN=0    # Minimum idle connections (don't hold during crashes)

# ============================================================================
# GPU RENDERING (Vast.ai/Remote Streaming - Auto-configured by deploy script)
# ============================================================================
# These are auto-detected and persisted by scripts/deploy-vast.sh
# Do not set manually unless you know what you're doing

# X11 display (e.g., :0 for Xorg, :99 for Xvfb)
# DISPLAY=:99

# GPU rendering mode: xorg | xvfb-vulkan | headless-vulkan | headless-egl | ozone-headless
# GPU_RENDERING_MODE=xvfb-vulkan

# Vulkan ICD file path (NVIDIA only, not used on macOS)
# VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json

# XDG runtime directory (required for Vulkan/EGL initialization)
# XDG_RUNTIME_DIR=/tmp/runtime-root

# Use Xvfb virtual display (true when DISPLAY=:99)
# DUEL_CAPTURE_USE_XVFB=true

# Use headless Chrome mode (false for WebGPU - requires window context)
# STREAM_CAPTURE_HEADLESS=false

# Use EGL rendering without X server
# STREAM_CAPTURE_USE_EGL=false

# Use ozone-platform=headless for GPU rendering
# STREAM_CAPTURE_OZONE_HEADLESS=false

# Explicit Chrome executable path for reliable WebGPU
# STREAM_CAPTURE_EXECUTABLE=/usr/bin/google-chrome-unstable

# ============================================================================
# PULSEAUDIO (Audio Capture - Auto-configured by deploy script)
# ============================================================================

# PulseAudio runtime directory
# XDG_RUNTIME_DIR=/tmp/pulse-runtime

# PulseAudio server socket
# PULSE_SERVER=unix:/tmp/pulse-runtime/pulse/native

# ============================================================================
# STREAMING CONFIGURATION (Optional)
# ============================================================================

# Use production client build (vite preview) instead of dev server
# Significantly faster page loads, fixes 180s timeout issues
# DUEL_USE_PRODUCTION_CLIENT=true

# Placeholder frames during idle periods (prevents 30-min disconnect on Twitch/YouTube)
# Sends minimal JPEG frames at configured FPS when no live frames for 5 seconds
# STREAM_PLACEHOLDER_ENABLED=false

# Stream encoding settings
# STREAM_LOW_LATENCY=false          # Use zerolatency tune (faster playback start)
# STREAM_GOP_SIZE=60                # GOP size in frames (default: 60)

# Stream capture settings
# STREAM_AUDIO_ENABLED=true         # Enable audio capture
# PULSE_AUDIO_DEVICE=chrome_audio.monitor  # PulseAudio device to capture

# Browser restart interval (minutes) to prevent WebGPU OOM
# Default: 45 minutes
# STREAM_BROWSER_RESTART_INTERVAL=45

# Page navigation timeout (seconds) for Vite dev mode
# Default: 120s (2 minutes) - increased for WebGPU shader compilation
# STREAM_PAGE_NAVIGATION_TIMEOUT=120

# ============================================================================
# AGENT CONFIGURATION (Optional)
# ============================================================================

# Auto-spawn model agents when database is empty (useful for fresh deployments)
# SPAWN_MODEL_AGENTS=false
