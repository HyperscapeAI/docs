# Hyperscape Environment Variables
#
# FOR LOCAL DEVELOPMENT: Copy to .env and fill in your values
# FOR PRODUCTION (Vast.ai): Set these as GitHub Secrets in the repository
#
# Required GitHub Secrets for CI/CD:
#   - TWITCH_STREAM_KEY
#   - KICK_STREAM_KEY
#   - KICK_RTMP_URL
#   - X_STREAM_KEY
#   - X_RTMP_URL
#   - DATABASE_URL
#   - SOLANA_DEPLOYER_PRIVATE_KEY
#   - VAST_HOST, VAST_PORT, VAST_SSH_KEY (for deployment)
#
# NEVER commit secrets to the repository - they will be exposed in git history

# ============================================================================
# STREAMING KEYS (Required for live streaming)
# ============================================================================

# Twitch - Get from https://dashboard.twitch.tv/settings/stream
TWITCH_STREAM_KEY=

# Kick - Get from https://kick.com/dashboard/settings/stream
KICK_STREAM_KEY=
KICK_RTMP_URL=rtmps://fa723fc1b171.global-contribute.live-video.net/app

# X/Twitter - Get from https://studio.twitter.com
X_STREAM_KEY=
X_RTMP_URL=rtmp://sg.pscp.tv:80/x

# YouTube (explicitly disabled - set to empty string)
YOUTUBE_STREAM_KEY=

# ============================================================================
# STREAM CAPTURE CONFIGURATION
# ============================================================================

# Capture mode: cdp (default), webcodecs (experimental), mediarecorder (legacy)
STREAM_CAPTURE_MODE=cdp

# Stream resolution (must be even numbers)
STREAM_CAPTURE_WIDTH=1280
STREAM_CAPTURE_HEIGHT=720

# Target frames per second
STREAM_FPS=30

# JPEG quality for CDP mode (1-100, default: 80)
STREAM_CDP_QUALITY=80

# Stream encoding optimization
# false = film tune with B-frames (better compression, default)
# true = zerolatency tune (faster playback start, higher bitrate)
STREAM_LOW_LATENCY=false

# GOP size (keyframe interval) in frames (default: 60 = 2s at 30fps)
# Lower values = faster playback start but larger file size
STREAM_GOP_SIZE=60

# Audio streaming
STREAM_AUDIO_ENABLED=true
PULSE_AUDIO_DEVICE=chrome_audio.monitor

# Stream capture recovery settings
STREAM_CAPTURE_RECOVERY_TIMEOUT_MS=30000
STREAM_CAPTURE_RECOVERY_MAX_FAILURES=6

# Browser configuration (auto-configured by deploy-vast.sh)
# STREAM_CAPTURE_CHANNEL=chrome-dev
# STREAM_CAPTURE_EXECUTABLE=/usr/bin/google-chrome-unstable
# STREAM_CAPTURE_HEADLESS=false  # Always false - WebGPU requires display
# STREAM_CAPTURE_USE_EGL=false   # Always false - WebGPU requires ANGLE/Vulkan
# STREAM_CAPTURE_OZONE_HEADLESS=false  # Experimental headless GPU mode

# ============================================================================
# SOLANA KEYS (Required for on-chain features)
# ============================================================================

# Set a single deployer key to use for all roles, or set each individually
SOLANA_DEPLOYER_PRIVATE_KEY=

# Or set individual keys:
# SOLANA_ARENA_AUTHORITY_SECRET=
# SOLANA_ARENA_REPORTER_SECRET=
# SOLANA_ARENA_KEEPER_SECRET=
# SOLANA_MM_PRIVATE_KEY=

# ============================================================================
# DATABASE (Production)
# ============================================================================

# PostgreSQL connection string
DATABASE_URL=

# ============================================================================
# DISPLAY (GPU Rendering - Vast.ai/Remote)
# ============================================================================

# Use :0 for real Xorg display, :99 for Xvfb
# Auto-configured by deploy-vast.sh based on GPU availability
DISPLAY=:0

# GPU rendering mode: xorg, xvfb-vulkan, ozone-headless
# Auto-configured by deploy-vast.sh
GPU_RENDERING_MODE=xorg

# Set to true when using Xvfb virtual display
# Auto-configured by deploy-vast.sh
DUEL_CAPTURE_USE_XVFB=false

# Force NVIDIA Vulkan ICD (prevents Mesa conflicts)
# Auto-configured by deploy-vast.sh
VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json

# ============================================================================
# PULSEAUDIO (Audio Capture)
# ============================================================================

# PulseAudio runtime directory (user-mode)
XDG_RUNTIME_DIR=/tmp/pulse-runtime

# PulseAudio socket path
PULSE_SERVER=unix:/tmp/pulse-runtime/pulse/native

# PulseAudio sink for Chrome audio
PULSE_SINK=chrome_audio

# ============================================================================
# PRODUCTION CLIENT BUILD
# ============================================================================

# Use pre-built client for faster page loads (fixes 180s timeout)
# Set to true for production streaming
DUEL_USE_PRODUCTION_CLIENT=true

# ============================================================================
# JWT & AUTHENTICATION
# ============================================================================

# JWT secret for signing authentication tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Arena external bet write key (for POST /api/arena/bet/record-external)
ARENA_EXTERNAL_BET_WRITE_KEY=
