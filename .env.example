# Hyperscape Environment Variables
#
# FOR LOCAL DEVELOPMENT: Copy to .env and fill in your values
# FOR PRODUCTION (Vast.ai): Set these as GitHub Secrets in the repository
#
# Required GitHub Secrets for CI/CD:
#   - TWITCH_STREAM_KEY
#   - KICK_STREAM_KEY
#   - KICK_RTMP_URL
#   - X_STREAM_KEY
#   - X_RTMP_URL
#   - DATABASE_URL
#   - SOLANA_DEPLOYER_PRIVATE_KEY
#   - VAST_HOST, VAST_PORT, VAST_SSH_KEY (for deployment)
#
# NEVER commit secrets to the repository - they will be exposed in git history

# ============================================================================
# STREAMING KEYS (Required for live streaming)
# ============================================================================

# Twitch - Get from https://dashboard.twitch.tv/settings/stream
TWITCH_STREAM_KEY=

# Kick - Get from https://kick.com/dashboard/settings/stream
KICK_STREAM_KEY=
KICK_RTMP_URL=rtmps://fa723fc1b171.global-contribute.live-video.net/app

# X/Twitter - Get from https://studio.twitter.com
X_STREAM_KEY=
X_RTMP_URL=rtmp://sg.pscp.tv:80/x

# YouTube (optional - currently disabled in production)
YOUTUBE_STREAM_KEY=

# ============================================================================
# SOLANA KEYS (Required for on-chain features)
# ============================================================================

# Set a single deployer key to use for all roles, or set each individually
SOLANA_DEPLOYER_PRIVATE_KEY=

# Or set individual keys:
# SOLANA_ARENA_AUTHORITY_SECRET=
# SOLANA_ARENA_REPORTER_SECRET=
# SOLANA_ARENA_KEEPER_SECRET=
# SOLANA_MM_PRIVATE_KEY=

# ============================================================================
# DATABASE (Production)
# ============================================================================

# PostgreSQL connection string
DATABASE_URL=

# ============================================================================
# GPU RENDERING (Vast.ai/Remote Servers)
# ============================================================================

# X11 display server (use :0 for real Xorg, :99 for Xvfb)
DISPLAY=:0

# GPU rendering mode (auto-detected by deploy script)
# Options: xorg | xvfb-vulkan | headless-egl | ozone-headless
# GPU_RENDERING_MODE=xorg

# Vulkan ICD file path (NVIDIA GPU required)
# VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json

# Set to true when using Xvfb virtual display instead of Xorg
DUEL_CAPTURE_USE_XVFB=false

# PulseAudio configuration for audio capture
# XDG_RUNTIME_DIR=/tmp/pulse-runtime
# PULSE_SERVER=unix:/tmp/pulse-runtime/pulse/native

# ============================================================================
# STREAM CAPTURE CONFIGURATION
# ============================================================================

# Chrome executable path for reliable WebGPU support
# Recommended: /usr/bin/google-chrome-unstable (Chrome Dev channel)
# STREAM_CAPTURE_EXECUTABLE=/usr/bin/google-chrome-unstable

# Chrome headless mode: false (headful), true (legacy headless), "new" (headless with GPU)
# CRITICAL: Must be false or "new" for WebGPU support
STREAM_CAPTURE_HEADLESS=false

# Use EGL rendering (headless GPU mode without X server)
# Enables direct EGL rendering with --use-gl=egl
STREAM_CAPTURE_USE_EGL=false

# Use Ozone headless platform (experimental GPU mode)
# Enables --ozone-platform=headless for GPU without X11
STREAM_CAPTURE_OZONE_HEADLESS=false

# ANGLE backend for WebGPU (default: vulkan on Linux, metal on macOS)
# Options: vulkan | metal | swiftshader (software fallback)
# STREAM_CAPTURE_ANGLE=vulkan

# ============================================================================
# STREAM ENCODING SETTINGS
# ============================================================================

# Low-latency encoding (zerolatency tune, faster playback start)
# Default: false (uses "film" tune with B-frames for better compression)
STREAM_LOW_LATENCY=false

# GOP (Group of Pictures) size in frames (default: 60)
# Lower values = faster seeking, higher values = better compression
STREAM_GOP_SIZE=60

# CDP screencast JPEG quality (1-100, default: 80)
# Higher = better quality but more bandwidth
STREAM_CDP_QUALITY=80

# Target frames per second (default: 30)
STREAM_FPS=30

# Viewport dimensions (must be even numbers)
STREAM_CAPTURE_WIDTH=1280
STREAM_CAPTURE_HEIGHT=720

# ============================================================================
# AUDIO CAPTURE
# ============================================================================

# Enable audio capture from PulseAudio
STREAM_AUDIO_ENABLED=true

# PulseAudio device to capture from (monitor of chrome_audio sink)
PULSE_AUDIO_DEVICE=chrome_audio.monitor

# ============================================================================
# PRODUCTION CLIENT BUILD
# ============================================================================

# Use production client build instead of Vite dev server
# Fixes browser timeout issues (180s limit) caused by JIT compilation
# Significantly faster page loads for streaming
NODE_ENV=production
DUEL_USE_PRODUCTION_CLIENT=true

# ============================================================================
# STREAM HEALTH & RECOVERY
# ============================================================================

# Browser restart interval in milliseconds (default: 45 minutes)
# Prevents WebGPU OOM crashes during long streaming sessions
# BROWSER_RESTART_INTERVAL_MS=2700000

# Capture recovery timeout in milliseconds (default: 30s)
# STREAM_CAPTURE_RECOVERY_TIMEOUT_MS=30000

# Maximum consecutive recovery failures before fallback (default: 4)
# STREAM_CAPTURE_RECOVERY_MAX_FAILURES=4

# Health check timeout in seconds (default: 5s)
# STREAM_HEALTH_CHECK_TIMEOUT=5

# Data timeout in seconds (default: 15s)
# STREAM_DATA_TIMEOUT=15
