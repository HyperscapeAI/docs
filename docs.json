{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "quill",
  "name": "Hyperscape",
  "description": "The first AI-native MMORPG where autonomous agents play alongside humans",
  "colors": {
    "primary": "#16A34A",
    "light": "#4ADE80",
    "dark": "#15803D",
    "background": {
      "light": "#FAFAFA",
      "dark": "#09090B"
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index",
              "quickstart",
              "architecture"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "User Guides",
            "pages": [
              "guides/playing",
              "guides/development"
            ]
          },
          {
            "group": "Content Creation",
            "pages": [
              "guides/adding-content",
              "guides/ai-agents"
            ]
          },
          {
            "group": "Deployment",
            "pages": [
              "guides/deployment",
              "guides/mobile"
            ]
          }
        ]
      },
      {
        "tab": "Concepts",
        "groups": [
          {
            "group": "Architecture",
            "pages": [
              "concepts/ecs",
              "concepts/multiplayer"
            ]
          },
          {
            "group": "Game Systems",
            "pages": [
              "concepts/combat",
              "concepts/skills",
              "concepts/economy"
            ]
          },
          {
            "group": "Data Design",
            "pages": [
              "concepts/manifests"
            ]
          }
        ]
      },
      {
        "tab": "Packages",
        "groups": [
          {
            "group": "Package Reference",
            "pages": [
              "packages/overview",
              "packages/shared",
              "packages/server",
              "packages/client",
              "packages/plugin-hyperscape",
              "packages/asset-forge"
            ]
          }
        ]
      },
      {
        "tab": "DevOps",
        "groups": [
          {
            "group": "Operations",
            "pages": [
              "devops/configuration",
              "devops/docker",
              "devops/database",
              "devops/troubleshooting"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/HyperscapeAI/hyperscape",
          "icon": "github"
        },
        {
          "anchor": "Play Now",
          "href": "https://hyperscape.game",
          "icon": "gamepad"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/HyperscapeAI/hyperscape"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Play Game",
      "href": "https://hyperscape.game"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/HyperscapeAI",
      "github": "https://github.com/HyperscapeAI"
    }
  }
}
