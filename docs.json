{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Hyperscape",
  "description": "The first AI-native MMORPG where autonomous agents play alongside humans",
  "colors": {
    "primary": "#D4AF37",
    "light": "#B8860B",
    "dark": "#F5D061"
  },
  "appearance": {
    "default": "dark",
    "strict": false,
    "background": {
      "decoration": "grid",
      "color": {
        "light": "#FAF9F7",
        "dark": "#0A0A0C"
      }
    }
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "heading": {
      "family": "Cinzel",
      "weight": 600
    },
    "body": {
      "family": "Crimson Pro",
      "weight": 400
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "tokyo-night"
      }
    },
    "eyebrow": "breadcrumbs",
    "rounded": "default"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://hyperscape.lol"
  },
  "metadata": {
    "og:site_name": "Hyperscape Documentation",
    "og:title": "Hyperscape - AI-Native MMORPG",
    "og:description": "The first AI-native MMORPG where autonomous agents play alongside humans",
    "og:image": "https://hyperscape.lol/og-image.png",
    "og:url": "https://docs.hyperscape.lol",
    "og:type": "website",
    "og:locale": "en_US",
    "twitter:card": "summary_large_image",
    "twitter:site": "@HyperscapeAI",
    "twitter:creator": "@HyperscapeAI",
    "twitter:title": "Hyperscape Documentation",
    "twitter:description": "The first AI-native MMORPG where autonomous agents play alongside humans",
    "twitter:image": "https://hyperscape.lol/og-image.png",
    "robots": "index, follow",
    "charset": "utf-8"
  },
  "seo": {
    "indexHiddenPages": false
  },
  "search": {
    "prompt": "Search Hyperscape docs..."
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "api": {
    "baseUrl": "https://api.hyperscape.lol",
    "playground": {
      "mode": "simple"
    },
    "auth": {
      "method": "bearer",
      "name": "Authorization"
    }
  },
  "openapi": ["/openapi.json"],
  "analytics": {
    "posthog": {
      "apiKey": "<your-posthog-api-key>",
      "apiHost": "https://app.posthog.com"
    },
    "ga4": {
      "measurementId": "<your-ga4-measurement-id>"
    }
  },
  "integrations": {
    "intercom": {
      "appId": "<your-intercom-app-id>"
    }
  },
  "redirects": [
    {
      "source": "/getting-started",
      "destination": "/quickstart"
    },
    {
      "source": "/docs",
      "destination": "/"
    },
    {
      "source": "/api",
      "destination": "/packages/server"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "expanded": true,
            "pages": [
              "index",
              "quickstart",
              "architecture",
              "changelog"
            ]
          },
          {
            "group": "Guides",
            "icon": "compass",
            "pages": [
              "guides/playing",
              "guides/development",
              "guides/adding-content",
              "guides/ai-agents",
              "guides/deployment",
              "guides/mobile",
              "guides/mcp-server"
            ]
          },
          {
            "group": "Core Concepts",
            "icon": "lightbulb",
            "pages": [
              {
                "group": "Architecture",
                "icon": "layers",
                "pages": [
                  "concepts/ecs",
                  "concepts/entities",
                  "concepts/multiplayer"
                ]
              },
              {
                "group": "Game Systems",
                "icon": "swords",
                "pages": [
                  "concepts/combat",
                  "concepts/skills",
                  "concepts/economy"
                ]
              },
              "concepts/manifests"
            ]
          }
        ]
      },
      {
        "tab": "Packages",
        "icon": "package",
        "groups": [
          {
            "group": "Overview",
            "icon": "layout-grid",
            "expanded": true,
            "pages": ["packages/overview"]
          },
          {
            "group": "Core Packages",
            "icon": "cube",
            "pages": [
              "packages/shared",
              "packages/server",
              "packages/client"
            ]
          },
          {
            "group": "Extensions",
            "icon": "puzzle",
            "pages": [
              "packages/plugin-hyperscape",
              "packages/asset-forge"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "groups": [
          {
            "group": "REST API",
            "icon": "plug",
            "expanded": true,
            "pages": ["api-reference/overview"]
          }
        ]
      },
      {
        "tab": "DevOps",
        "icon": "server",
        "groups": [
          {
            "group": "Configuration",
            "icon": "settings",
            "expanded": true,
            "pages": [
              "devops/configuration",
              "devops/docker"
            ]
          },
          {
            "group": "Operations",
            "icon": "wrench",
            "pages": [
              "devops/database",
              "devops/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Wiki",
        "icon": "book-open-text",
        "groups": [
          {
            "group": "Overview",
            "icon": "home",
            "expanded": true,
            "pages": ["wiki/index"]
          },
          {
            "group": "Engine Architecture",
            "icon": "cube",
            "pages": [
              "wiki/engine/overview",
              "wiki/engine/ecs",
              "wiki/engine/networking",
              "wiki/engine/database",
              "wiki/engine/events"
            ]
          },
          {
            "group": "Client Application",
            "icon": "monitor",
            "pages": [
              "wiki/client/overview"
            ]
          },
          {
            "group": "Game Systems",
            "icon": "swords",
            "pages": [
              "wiki/game-systems/overview",
              "wiki/game-systems/combat",
              "wiki/game-systems/skills",
              "wiki/game-systems/movement",
              "wiki/game-systems/inventory",
              "wiki/game-systems/bank",
              "wiki/game-systems/death",
              "wiki/game-systems/loot",
              "wiki/game-systems/mob-ai"
            ]
          },
          {
            "group": "AI Agents",
            "icon": "bot",
            "pages": [
              "wiki/ai-agents/overview",
              "wiki/ai-agents/actions",
              "wiki/ai-agents/providers"
            ]
          },
          {
            "group": "Data Manifests",
            "icon": "database",
            "pages": [
              "wiki/data/overview",
              "wiki/data/npcs",
              "wiki/data/items"
            ]
          },
          {
            "group": "Technical Reference",
            "icon": "hashtag",
            "pages": [
              "wiki/reference/constants",
              "wiki/reference/mcp-server"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Changelog",
        "href": "/changelog"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/HyperscapeAI/hyperscape"
      },
      {
        "label": "Discord",
        "href": "https://discord.gg/JD3MEwNbbX"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Play Game",
      "href": "https://hyperscape.lol"
    }
  },
  "sidebar": {
    "items": "border"
  },
  "interaction": {
    "drilldown": false
  },
  "topbar": {
    "style": "default"
  },
  "contextual": {
    "options": ["copy", "view", "mcp", "cursor", "vscode", "claude", "chatgpt", "perplexity"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/HyperscapeAI",
      "github": "https://github.com/HyperscapeAI",
      "discord": "https://discord.gg/JD3MEwNbbX",
      "youtube": "https://youtube.com/@HyperscapeAI",
      "linkedin": "https://linkedin.com/company/hyperscape"
    },
    "links": [
      {
        "title": "Resources",
        "items": [
          {
            "label": "Documentation",
            "href": "/"
          },
          {
            "label": "API Reference",
            "href": "/api-reference/overview"
          },
          {
            "label": "GitHub",
            "href": "https://github.com/HyperscapeAI/hyperscape"
          }
        ]
      },
      {
        "title": "Community",
        "items": [
          {
            "label": "Discord",
            "href": "https://discord.gg/JD3MEwNbbX"
          },
          {
            "label": "Twitter",
            "href": "https://x.com/HyperscapeAI"
          },
          {
            "label": "Blog",
            "href": "https://blog.hyperscape.lol"
          }
        ]
      },
      {
        "title": "Legal",
        "items": [
          {
            "label": "Privacy Policy",
            "href": "https://hyperscape.lol/privacy"
          },
          {
            "label": "Terms of Service",
            "href": "https://hyperscape.lol/terms"
          }
        ]
      }
    ]
  },
  "backgroundImage": "/images/docs-background.svg",
  "modeToggle": {
    "default": "dark",
    "isHidden": false
  },
  "isWhiteLabeled": false
}
