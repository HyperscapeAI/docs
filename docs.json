{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Hyperscape",
  "description": "The first AI-native MMORPG where autonomous agents play alongside humans",
  "colors": {
    "primary": "#CA8A04",
    "light": "#18181B",
    "dark": "#FACC15"
  },
  "appearance": {
    "default": "dark",
    "background": {
      "decoration": "windows",
      "color": {
        "light": "#FAFAF9",
        "dark": "#09090B"
      }
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "one-dark-pro"
      }
    },
    "eyebrow": "breadcrumbs"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "icon": "rocket",
        "groups": [
          {
            "group": "Overview",
            "icon": "home",
            "pages": ["index", "quickstart", "architecture"]
          }
        ]
      },
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "User Guides",
            "icon": "user",
            "pages": ["guides/playing", "guides/development"]
          },
          {
            "group": "Content Creation",
            "icon": "puzzle",
            "pages": ["guides/adding-content", "guides/ai-agents"]
          },
          {
            "group": "Deployment",
            "icon": "cloud-upload",
            "pages": ["guides/deployment", "guides/mobile"]
          }
        ]
      },
      {
        "tab": "Concepts",
        "icon": "lightbulb",
        "groups": [
          {
            "group": "Architecture",
            "icon": "layers",
            "pages": ["concepts/ecs", "concepts/multiplayer"]
          },
          {
            "group": "Game Systems",
            "icon": "swords",
            "pages": ["concepts/combat", "concepts/skills", "concepts/economy"]
          },
          {
            "group": "Data Design",
            "icon": "database",
            "pages": ["concepts/manifests"]
          }
        ]
      },
      {
        "tab": "Packages",
        "icon": "package",
        "groups": [
          {
            "group": "Package Reference",
            "icon": "folder-open",
            "pages": [
              "packages/overview",
              "packages/shared",
              "packages/server",
              "packages/client",
              "packages/plugin-hyperscape",
              "packages/asset-forge"
            ]
          }
        ]
      },
      {
        "tab": "DevOps",
        "icon": "settings",
        "groups": [
          {
            "group": "Operations",
            "icon": "wrench",
            "pages": [
              "devops/configuration",
              "devops/docker",
              "devops/database",
              "devops/troubleshooting"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/HyperscapeAI/hyperscape",
          "icon": "github"
        },
        {
          "anchor": "Play Game",
          "href": "https://hyperscape.game",
          "icon": "gamepad-2"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/HyperscapeAI/hyperscape"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Play Game",
      "href": "https://hyperscape.game"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/HyperscapeAI",
      "github": "https://github.com/HyperscapeAI"
    }
  }
}
